{
  "name": "@yolo/macos",
  "version": "0.1.5",
  "private": true,
  "description": "你只活一次 · macOS (x64 / arm64) 桌面端",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --port 5276 --strictPort\" \"wait-on http://127.0.0.1:5276 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5276 node scripts/run-electron.cjs\"",
    "build": "vite build",
    "start": "npm run build && node scripts/run-electron.cjs",
    "start:demo": "npm run build && node scripts/run-electron.cjs --demo",
    "typecheck": "tsc --noEmit",
    "screenshot": "node ../../scripts/screenshot.mjs",
    "package": "npm run build && electron-builder --mac dmg zip --x64 --arm64",
    "package:dir": "npm run build && electron-builder --linux dir",
    "package:x64": "npm run build && electron-builder --mac dmg zip --x64",
    "package:arm64": "npm run build && electron-builder --mac dmg zip --arm64"
  },
  "dependencies": {
    "@yolo/core": "*",
    "immer": "^10.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3",
    "@yolo/desktop-ui": "*"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "author": {
    "name": "YOLO Project",
    "email": "yolo@example.local"
  },
  "license": "MIT",
  "build": {
    "appId": "com.yolo.macos",
    "productName": "You Only Live Once",
    "artifactName": "YouOnlyLiveOnce-${version}-mac-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronVersion": "44.9.0",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  },
  "homepage": "https://example.com/you-only-live-once",
  "desktopName": "yolo.desktop"
}
