{
  "name": "@yolo/windows",
  "version": "0.1.7",
  "private": true,
  "description": "你只活一次 · Windows (x64) 桌面端",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --port 5274 --strictPort\" \"wait-on http://127.0.0.1:5274 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5274 node scripts/run-electron.cjs\"",
    "build": "vite build",
    "start": "npm run build && node scripts/run-electron.cjs",
    "start:demo": "npm run build && node scripts/run-electron.cjs --demo",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --win nsis portable --x64",
    "package:dir": "npm run build && electron-builder --win dir --x64",
    "package:portable": "npm run build && electron-builder --win dir --x64 && node scripts/zip-portable.mjs",
    "package:portable:arm64": "npm run build && electron-builder --win dir --arm64 && node scripts/zip-portable.mjs arm64"
  },
  "dependencies": {
    "@yolo/core": "*",
    "@yolo/desktop-ui": "*",
    "immer": "^10.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "author": {
    "name": "YOLO Project",
    "email": "yolo@example.local"
  },
  "license": "MIT",
  "homepage": "https://example.com/you-only-live-once",
  "build": {
    "appId": "com.yolo.windows",
    "productName": "You Only Live Once",
    "artifactName": "YouOnlyLiveOnce-${version}-win-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronVersion": "44.9.0",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "executableName": "yolo",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "你只活一次",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  }
}
