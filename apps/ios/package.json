{
  "name": "@yolo/ios",
  "version": "0.1.3",
  "private": true,
  "description": "你只活一次 · iOS 手机版（Capacitor）",
  "scripts": {
    "dev": "vite --port 5277 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5277 --strictPort",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync ios",
    "cap:add": "cap add ios",
    "ios:build": "node scripts/build-ipa.mjs",
    "package": "npm run build && npm run ios:build"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@yolo/core": "*",
    "@yolo/desktop-ui": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@capacitor/ios": "^7.6.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.3"
  },
  "author": {
    "name": "YOLO Project",
    "email": "yolo@example.local"
  },
  "license": "MIT"
}
