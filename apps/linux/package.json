{
  "name": "@yolo/linux",
  "version": "0.1.7",
  "private": true,
  "description": "你只活一次 · Linux (x64) 桌面端",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --port 5273 --strictPort\" \"wait-on http://127.0.0.1:5273 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5273 node scripts/run-electron.cjs\"",
    "build": "vite build",
    "start": "npm run build && node scripts/run-electron.cjs",
    "start:demo": "npm run build && node scripts/run-electron.cjs --demo",
    "typecheck": "tsc --noEmit",
    "screenshot": "node ../../scripts/screenshot.mjs",
    "package": "npm run build && electron-builder --linux AppImage deb",
    "package:dir": "npm run build && electron-builder --linux dir",
    "package:arm64": "npm run build && electron-builder --linux AppImage deb --arm64"
  },
  "dependencies": {
    "@yolo/core": "*",
    "immer": "^10.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3",
    "@yolo/desktop-ui": "*"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "author": {
    "name": "YOLO Project",
    "email": "yolo@example.local"
  },
  "license": "MIT",
  "build": {
    "appId": "com.yolo.linux",
    "productName": "You Only Live Once",
    "artifactName": "YouOnlyLiveOnce-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "yolo",
      "synopsis": "以终为始的任务旅程",
      "description": "你只活一次：任务表、启程侦查、单计时、知识点星图与成长证据。",
      "desktop": {
        "entry": {
          "Name": "你只活一次",
          "Name[en]": "You Only Live Once",
          "Comment": "把有限的时间，用在真正重要的事上。",
          "Categories": "Utility;Office;"
        }
      },
      "syncDesktopName": true
    },
    "electronVersion": "44.9.0"
  },
  "homepage": "https://example.com/you-only-live-once",
  "desktopName": "yolo.desktop"
}
